// To use this file, compile it with ppdc to generate a PPD file.
// Ppdc is part of cupsddk, Cups driver development kit.

// Include standard font and media definitions
#include <font.defs>
#include <media.defs>
#include <raster.defs>

// List the fonts that are supported, in this case all standard
// fonts...
Font *

// Manufacturer, model name, and version
Manufacturer "Lexmark"
ModelName "Z33"
Version 1.0

// Each filter provided by the driver...
Filter application/vnd.cups-raster 100 rastertolxz33

// Supported page sizes
*MediaSize A4
MediaSize Letter

// Supports color printing
ColorDevice true

// Supported color spaces
*ColorModel Black/Black k chunky 0
ColorModel CMYK/Color cmyk chunky 0

// Supported resolutions
//          Colorspace, no change
//          | Bits per color
//          | |  Rows per band
//          | |  |  Row feed
//          | |  |  | Row Step
//          | |  |  | | Name and text
*Resolution - 1 192 0 0 "600dpi/600 DPI"

// Specify the name of the PPD file we want to generate...
PCFileName "lxz33.ppd"

